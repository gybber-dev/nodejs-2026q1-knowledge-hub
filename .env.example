PORT=4000

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# local app + docker db: host=localhost
# docker app + docker db: host=db (service name in docker-compose)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/knowledge_hub?schema=public"

# Optional: overrides os.cpus().length * 2 + 1
# DB_POOL_SIZE=10